# Runtime
NODE_ENV=development
HOST=127.0.0.1
API_PORT=8787
CAMPUS_FORUM_DB=./data/campus-forum.db
CAMPUS_FORUM_UPLOADS=./data/uploads
CAMPUS_NAME=知行大学

# Comma-separated school email domains. Set the exact university domains in production.
CAMPUS_EMAIL_DOMAINS=example.edu.cn

# Production safety
CORS_ALLOWED_ORIGINS=https://forum.example.edu.cn
TRUST_PROXY=1
ALLOW_DEMO_CREDENTIALS=false

# Optional verification delivery webhook. Receives {email, code, campus, purpose}.
VERIFICATION_WEBHOOK_URL=
VERIFICATION_WEBHOOK_TOKEN=

# Optional OpenAI-compatible content review endpoint (full chat-completions URL).
LLM_MODERATION_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=5000
